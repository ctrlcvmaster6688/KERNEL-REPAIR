{"example":["r0 = openat$uhid(0xffffffffffffff9c, \u0026(0x7f0000000080), 0x802, 0x0)\nwrite$UHID_CREATE2(r0, \u0026(0x7f0000000080)={0xb, {'syz0\\x00', 'syz0\\x00', 'syz1\\x00', 0x1, 0x1000, 0x0, 0x0, 0x0, 0x0, \"80\"}}, 0x119)\nwrite$UHID_INPUT(r0, \u0026(0x7f0000000040)={0x8, {PLACEHOLDER_0, 0x1000}}, 0x1006)\n"],"definition":["openat$uhid(fd const[AT_FDCWD], file ptr[in, string[\"/dev/uhid\"]], flags flags[uhid_open_flags], mode const[0]) fd_uhid\n","write$UHID_CREATE2(fd fd_uhid, data ptr[in, uhid_req[UHID_CREATE2, uhid_create2_req]], len len[data])\n","write$UHID_INPUT(fd fd_uhid, data ptr[in, uhid_req[UHID_INPUT, uhid_input_req]], len len[data])\n"],"flags":{"AT_FDCWD":["ffffffffffffff9c"],"uhid_open_flags":["2","2050"]},"placeholders":{"PLACEHOLDER_0":""}}