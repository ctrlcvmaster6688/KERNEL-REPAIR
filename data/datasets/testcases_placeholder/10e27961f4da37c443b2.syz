{"example":["r0 = openat$udambuf(0xffffffffffffff9c, \u0026(0x7f0000000200), 0x2)\nr1 = memfd_create(\u0026(0x7f0000000000)='y\\x105%\\xa3\\xd5\\xfa\\xd7\\xfa\\x17\\xe9\\x99\\xa2\\x89\\x8e\\xcd\\xfd', 0x2)\npwrite64(r1, \u0026(0x7f00000000c0)=\"a0\", 0x1, 0x5b63)\nfcntl$addseals(r1, 0x409, 0x7)\nr2 = dup(r0)\nr3 = ioctl$UDMABUF_CREATE(r2, 0x40187542, \u0026(0x7f0000000080)={r1, 0x0, 0x0, 0x2000})\nioctl$DMA_BUF_IOCTL_SYNC(r3, 0x40086200, \u0026(0x7f0000000100)=0x2)\n"],"definition":["dup(oldfd fd) fd\n","ioctl$UDMABUF_CREATE(fd fd_udambuf, cmd const[UDMABUF_CREATE], arg ptr[in, udmabuf_create]) fd_dma_buf\n","ioctl$DMA_BUF_IOCTL_SYNC(fd fd_dma_buf, cmd const[DMA_BUF_IOCTL_SYNC], arg ptr[in, flags[dma_buf_sync_flags, int64]])\n","openat$udambuf(fd const[AT_FDCWD], file ptr[in, string[\"/dev/udmabuf\"]], flags const[O_RDWR]) fd_udambuf\n","memfd_create(name ptr[in, string], flags flags[memfd_flags]) fd_memfd\n","pwrite64(fd fd, buf buffer[in], count len[buf], pos fileoff)\n","fcntl$addseals(fd fd, cmd const[F_ADD_SEALS], seals flags[seal_types])\n"],"flags":{"AT_FDCWD":["ffffffffffffff9c"],"DMA_BUF_IOCTL_SYNC":["40086200"],"F_ADD_SEALS":["409"],"O_RDWR":["2"],"UDMABUF_CREATE":["40187542"],"memfd_flags":["1","2","4"],"seal_types":["1","2","4","8"]},"placeholders":{}}