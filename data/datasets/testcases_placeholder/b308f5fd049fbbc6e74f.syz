{"example":["r0 = syz_open_dev$tty1(0xc, 0x4, 0x1)\nioctl$TIOCL_SETSEL(r0, 0x4b61, \u0026(0x7f0000000040)={0x2, {0x3}})\nr1 = syz_open_dev$tty1(0xc, 0x4, 0x1)\nioctl$VT_RESIZEX(r1, 0x560a, \u0026(0x7f0000000200)={0x0, 0x0, 0x1, 0x9})\nr2 = syz_open_dev$tty1(0xc, 0x4, 0x1)\nr3 = dup(r2)\nwrite$UHID_INPUT(r3, \u0026(0x7f0000000180)={0x1200, {PLACEHOLDER_0, 0x1000}}, 0x1006)\n"],"definition":["ioctl$TIOCL_SETSEL(fd fd_tty, cmd const[TIOCLINUX], arg ptr[in, tiocl_selection_arg])\n","ioctl$VT_RESIZEX(fd fd_tty, cmd const[VT_RESIZEX], arg ptr[in, vt_consize])\n","dup(oldfd fd) fd\n","write$UHID_INPUT(fd fd_uhid, data ptr[in, uhid_req[UHID_INPUT, uhid_input_req]], len len[data])\n","syz_open_dev$tty1(dev const[0xc], major const[4], minor intptr[1:4]) fd_tty\n"],"flags":{"TIOCLINUX":["541c"],"VT_RESIZEX":["560a"]},"placeholders":{"PLACEHOLDER_0":""}}