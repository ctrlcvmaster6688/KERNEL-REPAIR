{"example":["r0 = open(\u0026(0x7f0000000080)='./bus\\x00', 0x105042, 0x0)\nioctl$FS_IOC_SETFLAGS(r0, 0x40086602, \u0026(0x7f0000000040))\nsetrlimit(0x1, \u0026(0x7f0000000100)={0xffffffffffffffff, 0xffffffffffffffff})\nr1 = open(\u0026(0x7f00000000c0)='./bus\\x00', 0x1c1042, 0x0)\npwrite64(r1, \u0026(0x7f0000000000)='+', 0x1, 0x4010000bffd)\nr2 = open(\u0026(0x7f0000000080)='./bus\\x00', 0x40002, 0x0)\nfallocate(r2, 0x3, 0x0, 0xffeffeff000) (async, rerun: 64)\npwritev2(r0, \u0026(0x7f0000001b40)=[{\u0026(0x7f0000000680)=\"43d4ae\", 0x20000683}], 0x1, 0x0, 0x0, 0x15)\n"],"definition":["open(file ptr[in, filename], flags flags[open_flags], mode flags[open_mode]) fd (automatic_helper)\n","ioctl$FS_IOC_SETFLAGS(fd fd, cmd const[FS_IOC_SETFLAGS], arg ptr[in, flags[fs_flags, int32]])\n","setrlimit(res flags[rlimit_type], rlim ptr[in, rlimit])\n","pwrite64(fd fd, buf buffer[in], count len[buf], pos fileoff)\n","fallocate(fd fd, mode flags[fallocate_mode], off intptr, len intptr)\n","pwritev2(fd fd, vec ptr[in, array[iovec_in]], vlen len[vec], off_low int32, off_high int32, flags flags[rwf_flags])\n"],"flags":{"FS_IOC_SETFLAGS":["40086602"],"fallocate_mode":["1","2","8","16","32","64","4"],"open_flags":["1","2","1024","8192","524288","64","16384","65536","128","32768","262144","256","131072","2048","2097152","1052672","512","4194304"],"open_mode":["256","128","64","32","16","8","4","2","1"],"rlimit_type":["9","4","0","2","1","10","8","12","13","7","6","5","14","15","11","3"],"rwf_flags":["2","1","4","8","16"]},"placeholders":{}}