{"example":["r0 = openat$rdma_cm(0xffffffffffffff9c, \u0026(0x7f0000000080), 0x2, 0x0)\nwrite$RDMA_USER_CM_CMD_CREATE_ID(r0, \u0026(0x7f00000002c0)={0x0, 0x18, 0xfa00, {0x0, \u0026(0x7f0000000000)={\u003cr1=\u003e0xffffffffffffffff}, 0x106}}, 0x20)\nwrite$RDMA_USER_CM_CMD_RESOLVE_IP(r0, \u0026(0x7f00000000c0)={0x3, 0x40, 0xfa00, {{0xa, 0x4e23, 0x0, @rand_addr=' \\x01\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x02', 0x5}, {0xa, 0x4e24, 0x40, @mcast1, 0x5}, r1}}, 0x48)\nwrite$RDMA_USER_CM_CMD_LISTEN(r0, \u0026(0x7f0000000040)={0x7, 0x8, 0xfa00, {r1}}, 0x10)\nwrite$RDMA_USER_CM_CMD_RESOLVE_IP(r0, \u0026(0x7f0000000200)={0x3, 0x40, 0xfa00, {{0x6000000, 0x0, 0x0, @local}, {0xa, 0x0, 0x0, @mcast1={0xff, 0x2}}, r1}}, 0x48)\n"],"definition":["write$RDMA_USER_CM_CMD_RESOLVE_IP(fd fd_rdma_cm, data ptr[in, rdma_ucm_cmd_t[RDMA_USER_CM_CMD_RESOLVE_IP, rdma_ucm_resolve_ip]], len bytesize[data])\n","write$RDMA_USER_CM_CMD_LISTEN(fd fd_rdma_cm, data ptr[in, rdma_ucm_cmd_t[RDMA_USER_CM_CMD_LISTEN, rdma_ucm_listen]], len bytesize[data])\n","openat$rdma_cm(fd const[AT_FDCWD], file ptr[in, string[\"/dev/infiniband/rdma_cm\"]], flags const[O_RDWR], mode const[0]) fd_rdma_cm\n","write$RDMA_USER_CM_CMD_CREATE_ID(fd fd_rdma_cm, data ptr[in, rdma_ucm_cmd_t[RDMA_USER_CM_CMD_CREATE_ID, rdma_ucm_create_id]], len bytesize[data])\n"],"flags":{"AT_FDCWD":["ffffffffffffff9c"],"O_RDWR":["2"]},"placeholders":{}}