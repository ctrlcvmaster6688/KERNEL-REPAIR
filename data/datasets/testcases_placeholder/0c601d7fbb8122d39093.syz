{"example":["r0 = openat$uhid(0xffffffffffffff9c, \u0026(0x7f0000000080), 0x2, 0x0)\nwrite$UHID_CREATE2(r0, \u0026(0x7f0000000900)=ANY=[@ANYBLOB=PLACEHOLDER_0], 0x12e)\nwrite$UHID_INPUT2(r0, \u0026(0x7f0000000140)={0xc, {0xcf, PLACEHOLDER_1}}, 0xd5)\n"],"definition":["openat$uhid(fd const[AT_FDCWD], file ptr[in, string[\"/dev/uhid\"]], flags flags[uhid_open_flags], mode const[0]) fd_uhid\n","write$UHID_CREATE2(fd fd_uhid, data ptr[in, uhid_req[UHID_CREATE2, uhid_create2_req]], len len[data])\n","write$UHID_INPUT2(fd fd_uhid, data ptr[in, uhid_req[UHID_INPUT2, uhid_input2_req]], len len[data])\n"],"flags":{"AT_FDCWD":["ffffffffffffff9c"],"uhid_open_flags":["2","2050"]},"placeholders":{"PLACEHOLDER_0":"","PLACEHOLDER_1":""}}