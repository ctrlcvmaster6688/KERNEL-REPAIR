{"example":["r0 = openat$ptmx(0xffffffffffffff9c, \u0026(0x7f0000000080), 0x0, 0x0)\nioctl$TIOCSETD(r0, 0x5423, \u0026(0x7f0000000040)=0xf)\nioctl$KDADDIO(r0, 0x400455c8, 0x2)\npipe(\u0026(0x7f0000000140)={0xffffffffffffffff, \u003cr1=\u003e0xffffffffffffffff})\nwrite(r1, \u0026(0x7f00000001c0), 0xfffffef3)\n"],"definition":["openat$ptmx(fd const[AT_FDCWD], file ptr[in, string[\"/dev/ptmx\"]], flags flags[open_flags], mode const[0]) fd_tty\n","ioctl$TIOCSETD(fd fd_tty, cmd const[TIOCSETD], arg ptr[in, int32[N_TTY:N_NULL]])\n","ioctl$KDADDIO(fd fd_tty, cmd const[KDADDIO], arg intptr)\n","pipe(pipefd ptr[out, pipefd])\n","write(fd fd, buf buffer[in], count len[buf])\n"],"flags":{"AT_FDCWD":["ffffffffffffff9c"],"KDADDIO":["4b34"],"TIOCSETD":["5423"]},"placeholders":{}}