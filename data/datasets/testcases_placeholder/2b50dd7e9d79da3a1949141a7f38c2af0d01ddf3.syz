{"example":["socket$packet(0x11, 0x3, 0x300)\npipe(\u0026(0x7f0000000180))\nr0 = socket$inet6_tcp(0xa, 0x1, 0x0)\nbind$inet6(r0, \u0026(0x7f0000000040)={0xa, 0x8000002, 0x0, @loopback}, 0x1c)\nsendto$inet6(r0, 0x0, 0x0, 0x22004001, \u0026(0x7f0000b63fe4)={0xa, 0x2, 0x0, @loopback}, 0x1c)\nwrite$binfmt_elf64(r0, \u0026(0x7f00000004c0)=ANY=[@ANYBLOB], 0x78)\nsendto$inet6(r0, \u0026(0x7f00000003c0)=PLACEHOLDER_0, 0xd7, 0x1, 0x0, 0x0)\nsplice(r0, 0x0, 0xffffffffffffffff, 0x0, 0x406f40a, 0x0)\n"],"definition":["sendto$inet6(fd sock_in6, buf buffer[in], len len[buf], f flags[send_flags], addr ptr[in, sockaddr_in6, opt], addrlen len[addr])\n","write$binfmt_elf64(fd fd_binfmt, data ptr[in, binfmt_elf64], len bytesize[data])\n","splice(fdin fd, offin ptr[in, fileoff[int64]], fdout fd, offout ptr[in, fileoff[int64]], len intptr, f flags[splice_flags])\n","socket$packet(domain const[AF_PACKET], type flags[packet_socket_type], proto const[ETH_P_ALL_BE]) sock_packet\n","pipe(pipefd ptr[out, pipefd])\n","socket$inet6_tcp(domain const[AF_INET6], type const[SOCK_STREAM], proto const[0]) sock_tcp6\n","bind$inet6(fd sock_in6, addr ptr[in, sockaddr_in6], addrlen len[addr])\n"],"flags":{"AF_INET6":["a"],"AF_PACKET":["11"],"ETH_P_ALL_BE":["300"],"SOCK_STREAM":["1"],"packet_socket_type":["3","2"],"send_flags":["2048","4","64","128","32768","16384","1","16","262144","536870912","67108864"],"splice_flags":["1","2","4","8"]},"placeholders":{"PLACEHOLDER_0":""}}