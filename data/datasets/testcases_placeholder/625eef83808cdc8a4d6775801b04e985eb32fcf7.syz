{"example":["syz_mount_image$btrfs(\u0026(0x7f00000000c0), \u0026(0x7f0000000040)='./file0\\x00', 0x800014, \u0026(0x7f0000000300)={[{@nossd_spread}, {@nodatacow}, {@usebackuproot}, {@metadata_ratio={'metadata_ratio', 0x3d, 0x61c}}, {@ref_verify}, {@noinode_cache}, {@user_subvol_rm}, {@enospc_debug}, {@nodiscard}, {@flushoncommit}]}, 0x4, 0x5132, \u0026(0x7f0000004440)=PLACEHOLDER_0)\nr0 = open(\u0026(0x7f0000001100)='./bus\\x00', 0x14d27e, 0x0)\nr1 = open(\u0026(0x7f0000007f80)='./bus\\x00', 0x143042, 0x0)\nwrite$binfmt_script(r1, \u0026(0x7f0000008040)={'#! ', './bus'}, 0x9)\nftruncate(r1, 0x2007ffb)\nsendfile(r0, r0, 0x0, 0x8800000)\nsendfile(r0, r0, 0x0, 0x8800000)\n"],"definition":["open(file ptr[in, filename], flags flags[open_flags], mode flags[open_mode]) fd (automatic_helper)\n","write$binfmt_script(fd fd_binfmt, data ptr[in, binfmt_script], len bytesize[data])\n","ftruncate(fd fd, len intptr)\n","sendfile(fdout fd, fdin fd, off ptr[inout, fileoff[intptr], opt], count intptr)\n","syz_mount_image$btrfs(fs ptr[in, string[\"btrfs\"]], dir ptr[in, filename], flags flags[mount_flags], opts ptr[in, fs_options[btrfs_options]], chdir bool8, size len[img], img ptr[in, compressed_image]) fd_dir (timeout[SYZ_MOUNT_IMAGE_TIMEOUT], no_generate, no_minimize, fsck[\"btrfsck --readonly\"])\n"],"flags":{"mount_flags":["4096","128","64","8192","1024","4","2048","8","2","1","2097152","32","32768","16777216","16","16384","65536","131072","262144","524288","1048576","8388608","33554432"],"open_flags":["1","2","1024","8192","524288","64","16384","65536","128","32768","262144","256","131072","2048","2097152","1052672","512","4194304"],"open_mode":["256","128","64","32","16","8","4","2","1"]},"placeholders":{"PLACEHOLDER_0":""}}