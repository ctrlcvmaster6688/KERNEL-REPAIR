{"example":["r0 = socket(0x11, 0x800000003, 0x0)\nbind(r0, \u0026(0x7f0000000080)=@generic={0x11, PLACEHOLDER_0}, 0x80)\ngetsockname$packet(r0, \u0026(0x7f00000003c0)={0x11, 0x0, 0x0, 0x1, 0x0, 0x6, @dev}, \u0026(0x7f0000000000)=0x14)\nr1 = socket(0x10, 0x3, 0x0)\nsendmsg$nl_route_sched(r1, \u0026(0x7f0000000800)={0x0, 0x0, \u0026(0x7f0000000040)={\u0026(0x7f0000000100)=@newqdisc={0x70, 0x24, 0xf0b, 0x0, 0x0, {0x0, 0x0, 0x0, 0x0, {0x0, 0x1}, {0xffff, 0xffff}}, [@qdisc_kind_options=@q_fq_codel={{0xd}, {0x3c, 0x2, [@TCA_FQ_CODEL_QUANTUM={0x8}, @TCA_FQ_CODEL_LIMIT={0x8}, @TCA_FQ_CODEL_DROP_BATCH_SIZE={0x8}, @TCA_FQ_CODEL_MEMORY_LIMIT={0x8, 0x9, 0x3}, @TCA_FQ_CODEL_QUANTUM={0x8, 0x6, 0xffffffff}, @TCA_FQ_CODEL_TARGET={0x8, 0x1, 0x6}, @TCA_FQ_CODEL_DROP_BATCH_SIZE={0x8, 0x8, 0x1}]}}]}, 0x70}}, 0x0)\n"],"definition":["socket(domain flags[socket_domain], type flags[socket_type], proto int32) sock (automatic_helper)\n","bind(fd sock, addr ptr[in, sockaddr_storage], addrlen len[addr])\n","getsockname$packet(fd sock_packet, addr ptr[out, sockaddr_ll], addrlen ptr[inout, len[addr, int32]])\n","sendmsg$nl_route_sched(fd sock_nl_route, msg ptr[in, msghdr_netlink[netlink_msg_route_sched]], f flags[send_flags])\n"],"flags":{"send_flags":["2048","4","64","128","32768","16384","1","16","262144","536870912","67108864"],"socket_domain":["1","2","10","16","9","3","8","5","17","40","44","30","33","24","21","11","35","39","6","15","41","34","43","29","37","31","26","38","42"],"socket_type":["1","2","3","4","5","6","10","2048","524288"]},"placeholders":{"PLACEHOLDER_0":""}}