{"example":["r0 = socket$inet_tcp(0x2, 0x1, 0x0)\nbind$inet(r0, \u0026(0x7f00000000c0)={0x2, 0x4e20, @multicast2}, 0x10)\nsetsockopt$sock_int(r0, 0x1, 0x3c, \u0026(0x7f0000000000)=0x1, 0x4)\nsendto$inet(r0, 0x0, 0x0, 0x20020001, \u0026(0x7f0000000080)={0x2, 0x4e20}, 0x10)\nsendmmsg$inet(r0, \u0026(0x7f0000003b40)=[{{0x0, 0x0, \u0026(0x7f00000026c0)=[{\u0026(0x7f0000003c80)=\"1e\", 0x1}], 0x1}}], 0x1, 0x60cd854)\nsendto$inet(r0, \u0026(0x7f0000000240)=\"b1\", 0x1, 0x0, 0x0, 0x0)\n"],"definition":["socket$inet_tcp(domain const[AF_INET], type const[SOCK_STREAM], proto const[0]) sock_tcp\n","bind$inet(fd sock_in, addr ptr[in, sockaddr_in], addrlen len[addr])\n","setsockopt$sock_int(fd sock, level const[SOL_SOCKET], optname flags[sockopt_opt_sock_int], optval ptr[in, int32], optlen len[optval])\n","sendto$inet(fd sock_in, buf buffer[in], len len[buf], f flags[send_flags], addr ptr[in, sockaddr_in, opt], addrlen len[addr])\n","sendmmsg$inet(fd sock, mmsg ptr[in, array[mmsghdr_inet]], vlen len[mmsg], f flags[send_flags])\n"],"flags":{"AF_INET":["2"],"SOCK_STREAM":["1"],"SOL_SOCKET":["1"],"send_flags":["2048","4","64","128","32768","16384","1","16","262144","536870912","67108864"],"sockopt_opt_sock_int":["30","6","1","39","4","5","9","42","12","38","8","33","18","19","2","7","32","29","3","15","10","11","16","35","44","34","40","41","43","45","46","47","60"]},"placeholders":{}}