{"example":["ioctl$EVIOCSFF(0xffffffffffffffff, 0x40304580, \u0026(0x7f00000000c0)={0x0, 0x0, 0x0, {}, {0x2, 0xfffc}, @cond=[{0x0, 0x0, 0x0, 0x0, 0x0, 0x44b1}, {0x0, 0x1ff}]})\nr0 = syz_open_dev$evdev(\u0026(0x7f0000000080), 0x0, 0x121041)\nfcntl$setstatus(r0, 0x4, 0x42000)\nwrite$evdev(r0, \u0026(0x7f0000000040), 0x373)\nr1 = socket$nl_generic(0x10, 0x3, 0x10)\nioctl$sock_SIOCGPGRP(r1, 0x8904, 0x0)\n"],"definition":["ioctl$EVIOCSFF(fd fd_evdev, cmd const[EVIOCSFF], arg ptr[in, ff_effect])\n","syz_open_dev$evdev(dev ptr[in, string[\"/dev/input/event#\"]], id intptr, flags flags[open_flags]) fd_evdev\n","fcntl$setstatus(fd fd, cmd const[F_SETFL], flags flags[fcntl_status])\n","write$evdev(fd fd_evdev, data ptr[in, array[input_event]], len bytesize[data])\n","socket$nl_generic(domain const[AF_NETLINK], type const[SOCK_RAW], proto const[NETLINK_GENERIC]) sock_nl_generic (automatic_helper)\n","ioctl$sock_SIOCGPGRP(fd sock, cmd const[SIOCGPGRP], arg ptr[out, pid])\n"],"flags":{"AF_NETLINK":["10"],"EVIOCSFF":["40304580"],"F_SETFL":["4"],"NETLINK_GENERIC":["10"],"SIOCGPGRP":["8904"],"SOCK_RAW":["3"],"fcntl_status":["1024","8192","16384","262144","2048"]},"placeholders":{}}