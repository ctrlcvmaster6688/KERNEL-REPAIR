{"example":["r0 = openat$udambuf(0xffffffffffffff9c, \u0026(0x7f00000000c0), 0x2)\nr1 = memfd_create(\u0026(0x7f0000000000)='y\\x105%\\xfa,\\x1f\\x99\\xa2\\xc9\\x8e\\xcd\\xfc\\xfa\\xf6\\x12\\x95^\\xdfT\\xe2=\\x0e~F\\xcds', 0x2)\nftruncate(r1, 0xffff)\nfcntl$addseals(r1, 0x409, 0x7)\nr2 = dup(r0)\nr3 = ioctl$UDMABUF_CREATE(r2, 0x40187542, \u0026(0x7f0000000080)={r1, 0x0, 0x0, 0x1000})\nioctl$DMA_BUF_IOCTL_SYNC(r3, 0x40086200, \u0026(0x7f0000000280)=0x2) (fail_nth: 4)\n"],"definition":["memfd_create(name ptr[in, string], flags flags[memfd_flags]) fd_memfd\n","ftruncate(fd fd, len intptr)\n","fcntl$addseals(fd fd, cmd const[F_ADD_SEALS], seals flags[seal_types])\n","dup(oldfd fd) fd\n","ioctl$UDMABUF_CREATE(fd fd_udambuf, cmd const[UDMABUF_CREATE], arg ptr[in, udmabuf_create]) fd_dma_buf\n","ioctl$DMA_BUF_IOCTL_SYNC(fd fd_dma_buf, cmd const[DMA_BUF_IOCTL_SYNC], arg ptr[in, flags[dma_buf_sync_flags, int64]])\n","openat$udambuf(fd const[AT_FDCWD], file ptr[in, string[\"/dev/udmabuf\"]], flags const[O_RDWR]) fd_udambuf\n"],"flags":{"AT_FDCWD":["ffffffffffffff9c"],"DMA_BUF_IOCTL_SYNC":["40086200"],"F_ADD_SEALS":["409"],"O_RDWR":["2"],"UDMABUF_CREATE":["40187542"],"memfd_flags":["1","2","4"],"seal_types":["1","2","4","8"]},"placeholders":{}}