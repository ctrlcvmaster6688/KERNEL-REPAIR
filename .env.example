# CoHiKer++ configuration.
#   cp .env.example .env     # fill in the blanks
#   bash run_pipeline.sh --syzid <syzid>
#
# paths.py reads <repo>/.env automatically; variables already exported in your
# shell win over this file. Values below are the built-in defaults unless blank.

# --- LLM (required) -------------------------------------------------------
# OpenAI-compatible endpoint, used by both halves.
LLM_API_KEY=
LLM_BASE_URL=https://chatapi.zjt66.top/v1
LLM_MODEL=deepseek-v3.2

# --- Embedding service (BGE-M3) ------------------------------------------
# Client = what this package calls. Server = tools/embed_server/flask_embedding.py
# (weights are not shipped: download BAAI/bge-m3 and set MODEL_PATH below).
EMBED_API_URL=http://127.0.0.1:6001/embed
COHIKER_EMBED_MODEL_PATH=
COHIKER_EMBED_PORT=6001
COHIKER_EMBED_DEVICE=auto
COHIKER_EMBED_MAX_LENGTH=1024

# --- Outbound proxy (optional; leave commented out with direct internet) --
# Used by pip/git/the LLM client. The embedding clients ignore it on purpose
# (trust_env=False), so a remote embedding service must not need a proxy.
#http_proxy=http://<proxy-host>:<port>
#https_proxy=http://<proxy-host>:<port>
# Mirror for the BGE-M3 download (huggingface.co may be unreachable)
#HF_ENDPOINT=https://hf-mirror.com

# --- Paths (the /data layout of the reference machine) --------------------
# One entry per parallel worker; the four worker lists must have equal length.
COHIKER_KERNEL_DIR_ORI=/data/linux-ori
COHIKER_CACHE_ROOT=/data/cache_linux
COHIKER_KERNEL_WORKER_DIRS=/data/linux-worker-0,/data/linux-worker-1,/data/linux-worker-2
COHIKER_SYZKALLER_WORKER_DIRS=/data/syzkaller_worker_0,/data/syzkaller_worker_1,/data/syzkaller_worker_2
COHIKER_QEMU_IMAGE_PATHS=/data/qemu-worker-0/bullseye.img,/data/qemu-worker-1/bullseye.img,/data/qemu-worker-2/bullseye.img
COHIKER_QEMU_SSH_KEYS=/data/qemu-worker-0/bullseye.id_rsa,/data/qemu-worker-1/bullseye.id_rsa,/data/qemu-worker-2/bullseye.id_rsa

# --- Optional -------------------------------------------------------------
# Blank -> /data/datasets if it exists, else the bundled data/datasets mirror
COHIKER_DATASETS_DIR=
# Blank -> /data/logs_new_v32, /data/output_patches_v32/patches,
#          /data/localization_output (they fall back to <repo>/runs/... without /data)
COHIKER_LOG_DIR=
COHIKER_PATCH_ARCHIVE_DIR=
COHIKER_LOCALIZATION_OUTPUT_DIR=
# Build parallelism and per-guest RAM. A kernel build wants ~1.5-2 GB per job,
# so 20 jobs peak around 30-40 GB: lower it on a small machine.
COHIKER_NUM_CORES=20
COHIKER_QEMU_MEM=4G
# Localization's own QEMU guest. Its ssh port must differ from the validators'
# 10021+worker_id when both halves run at the same time.
COHIKER_LOCALIZATION_QEMU_SSH_PORT=10022
COHIKER_LOCALIZATION_QEMU_MEM=4G

# --- Advanced (leave commented out unless you know you need it) -----------
# Where a *previously built* kernel cache may have been compiled. When a cache
# snapshot is restored to a different directory, KbuildManager looks for these
# prefixes inside the cached *.cmd files and rewrites them to the new path.
# Keep the default unless your cache was built somewhere else.
#COHIKER_KERNEL_WORKER_PATTERN=/data/linux-worker-{index}
#COHIKER_KERNEL_MAX_WORKERS=10
