# keep shell scripts and python sources LF so they run on Linux after a clone
# (a CRLF shell script breaks `bash run_pipeline.sh` on Linux)
* text=auto
*.sh   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.cff  text eol=lf
*.yml  text eol=lf

# binary artifacts: never diff/convert them
*.db   -text -diff
*.idx  -text -diff
*.so   -text -diff
*.pt   -text -diff

# experiment inputs (data/) must stay byte-identical to what the runs used:
# no EOL normalisation, no diff conversion.  These data files really do contain
# CRLF (kernel .config files, .syz reproducers, crash reports) and the pipeline
# was validated with exactly those bytes, so git must not rewrite them.
# NOTE: later rules override earlier ones -- keep this block last.
data/**  -text -diff

# If you prefer keeping the knowledge bases inside the repository instead of a
# release asset, install git-lfs, use these two lines instead of `data/*.db`
# in .gitignore, and re-add the files:
#   git lfs install && git lfs track "data/*.db"
# data/*.db filter=lfs diff=lfs merge=lfs -text
